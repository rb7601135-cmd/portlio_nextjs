# ==============================================================================
# Portfolio Contact Form Integration Configuration
# ==============================================================================

# Option A: Forward contact submissions via Resend API (https://resend.com)
# RESEND_API_KEY=re_123456789
# CONTACT_RECEIVER_EMAIL=rb7601135@gmail.com

# Option B: Forward contact submissions to a Webhook URL (Slack, Discord, Zapier)
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# If neither is set, contact submissions are safely validated and logged locally,
# clearly prompting the visitor to also use direct email links.
