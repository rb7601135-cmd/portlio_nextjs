# ==============================================================================
# Portfolio Gmail SMTP Contact Form Configuration
# ==============================================================================

# 1. Your primary Gmail address used to authenticate with Google's SMTP server
SMTP_USER=your-email@gmail.com

# 2. Dedicated 16-character Google App Password (without spaces)
# Generated from: Google Account > Security > 2-Step Verification > App passwords
SMTP_PASS=your-16-character-google-app-password

# 3. Destination inbox where visitor contact messages should be delivered
CONTACT_EMAIL=your-email@gmail.com

# ==============================================================================
# Optional Production Settings (e.g. Distributed Rate Limiting via Upstash Redis)
# ==============================================================================
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
